{
	admin off
	auto_https off
}

:{$CADDY_PORT:8080} {
	encode gzip

	# JSON API — same-origin proxy to the localhost-bound CAP API. No CORS needed.
	handle /api/* {
		reverse_proxy 127.0.0.1:3300
	}

	# Bundled-deployment signal for the Flutter web UI. The app fetches this at
	# boot and, seeing bundled:true, connects to this same origin instead of
	# asking for a server URL. Hosted deployments serve no config.json, so the
	# app keeps its normal manual-server behavior there.
	handle /config.json {
		header Content-Type application/json
		respond `{"bundled":true,"apiBaseUrl":"/api/v1"}` 200
	}

	# Flutter web (built --wasm) — requires cross-origin isolation.
	handle {
		root * /srv/web
		header {
			Cross-Origin-Opener-Policy "same-origin"
			Cross-Origin-Embedder-Policy "require-corp"
			Cross-Origin-Resource-Policy "same-origin"
			-Server
		}
		try_files {path} /index.html
		file_server
	}
}
